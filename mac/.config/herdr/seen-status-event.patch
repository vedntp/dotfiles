+#[test]
+fn viewing_done_agent_emits_single_idle_status_event() {
+    use crate::api::schema::{AgentStatus, EventData, EventKind};
+
+    fn statuses(server: &HeadlessServer, after: u64) -> Vec<(AgentStatus, Option<String>)> {
+        server
+            .app
+            .event_hub
+            .events_after(after)
+            .into_iter()
+            .filter_map(|(_, event)| match event.data {
+                EventData::PaneAgentStatusChanged {
+                    agent_status,
+                    agent,
+                    ..
+                } if event.event == EventKind::PaneAgentStatusChanged => {
+                    Some((agent_status, agent))
+                }
+                _ => None,
+            })
+            .collect()
+    }
+
+    let mut server = test_headless_server();
+    server.app.state.workspaces = vec![
+        crate::workspace::Workspace::test_new("active"),
+        crate::workspace::Workspace::test_new("background"),
+    ];
+    server.app.state.ensure_test_terminals();
+    server.app.state.active = Some(0);
+    let pane_id = server.app.state.workspaces[1].tabs[0].root_pane;
+    server.app.sync_seen_agent_status_events();
+
+    for state in [
+        crate::detect::AgentState::Working,
+        crate::detect::AgentState::Idle,
+    ] {
+        server.handle_internal_event_with_forwarding(AppEvent::HookStateReported {
+            pane_id,
+            source: "custom:pi".into(),
+            agent_label: "pi".into(),
+            state,
+            message: None,
+            seq: None,
+            session_ref: None,
+        });
+        server.app.sync_seen_agent_status_events();
+    }
+    assert!(!server.app.state.workspaces[1].panes[&pane_id].seen);
+    let reported = statuses(&server, 0);
+    assert_eq!(
+        reported.last(),
+        Some(&(AgentStatus::Done, Some("pi".into())))
+    );
+    let before_view = server.app.event_hub.current_sequence();
+
+    // Viewing the pane flips `seen` outside the agent state path.
+    server.app.state.focus_pane_in_workspace(1, pane_id);
+    server.app.state.mark_active_tab_seen();
+    assert!(server.app.state.workspaces[1].panes[&pane_id].seen);
+    server.app.sync_seen_agent_status_events();
+    server.app.sync_seen_agent_status_events();
+
+    assert_eq!(
+        statuses(&server, before_view),
+        vec![(AgentStatus::Idle, Some("pi".into()))]
+    );
+}
