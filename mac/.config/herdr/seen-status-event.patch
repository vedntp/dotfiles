+    /// Emits `pane.agent_status_changed` for panes whose derived status changed because only
+    /// `seen` flipped, e.g. done becoming idle once the user views the pane. Agent state
+    /// transitions are reported by `emit_pane_state_update`, which keeps the tracker current.
+    pub(crate) fn sync_seen_agent_status_events(&mut self) {
+        let mut changed = Vec::new();
+        for (ws_idx, ws) in self.state.workspaces.iter().enumerate() {
+            for (&pane_id, pane) in ws.tabs.iter().flat_map(|tab| tab.panes.iter()) {
+                let Some(terminal) = self.state.terminals.get(&pane.attached_terminal_id) else {
+                    continue;
+                };
+                let status = pane_agent_status(terminal.state, pane.seen);
+                let previous = self
+                    .reported_agent_status
+                    .insert(pane_id, (terminal.state, status));
+                if previous.is_some_and(|(state, previous_status)| {
+                    state == terminal.state && previous_status != status
+                }) {
+                    changed.push((ws_idx, pane_id, status));
+                }
+            }
+        }
+        let workspaces = &self.state.workspaces;
+        self.reported_agent_status.retain(|pane_id, _| {
+            workspaces
+                .iter()
+                .any(|ws| ws.pane_state(*pane_id).is_some())
+        });
+
+        for (ws_idx, pane_id, agent_status) in changed {
+            let Some(public_pane_id) = self.public_pane_id(ws_idx, pane_id) else {
+                continue;
+            };
+            let Some(terminal) = self.state.workspaces[ws_idx]
+                .pane_state(pane_id)
+                .and_then(|pane| self.state.terminals.get(&pane.attached_terminal_id))
+            else {
+                continue;
+            };
+            let agent = terminal.effective_agent_label().map(str::to_string);
+            let presentation = terminal.effective_presentation();
+            self.emit_event(crate::api::schema::EventEnvelope {
+                event: crate::api::schema::EventKind::PaneAgentStatusChanged,
+                data: crate::api::schema::EventData::PaneAgentStatusChanged {
+                    pane_id: public_pane_id,
+                    workspace_id: self.public_workspace_id(ws_idx),
+                    agent_status,
+                    agent,
+                    title: presentation.title,
+                    display_agent: presentation.display_agent,
+                    state_labels: presentation.state_labels,
+                },
+            });
+        }
+    }
