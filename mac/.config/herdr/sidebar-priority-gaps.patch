+/// Priority sort lists agents that need you, then working ones, then idle
+/// ones. Returns the group of an agent so the list can space the groups apart.
+pub(super) fn priority_group(
+    config: &ClientShellConfig,
+    agent_view_label: Option<&str>,
+    status: crate::api::schema::AgentStatus,
+) -> Option<u8> {
+    use crate::api::schema::AgentStatus;
+    if agent_view_label.is_some()
+        || config.agent_panel_sort != crate::config::AgentPanelSortConfig::Priority
+    {
+        return None;
+    }
+    Some(match status {
+        AgentStatus::Blocked | AgentStatus::Done => 0,
+        AgentStatus::Working => 1,
+        AgentStatus::Idle | AgentStatus::Unknown => 2,
+    })
+}
+
+/// Blank lines after each entry: the configured row gap, and at least one
+/// where the priority group changes.
+pub(super) fn agent_list_gaps(row_gap: u16, groups: &[Option<u8>]) -> Vec<u16> {
+    groups
+        .iter()
+        .enumerate()
+        .map(|(index, group)| match groups.get(index + 1) {
+            None => 0,
+            Some(next) if group.is_some() && next != group => row_gap.max(1),
+            Some(_) => row_gap,
+        })
+        .collect()
+}
