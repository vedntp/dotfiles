+#[cfg(test)]
+mod priority_gap_tests {
+    use super::agent_list_gaps;
+
+    #[test]
+    fn blank_line_where_priority_group_changes() {
+        let groups = [Some(0), Some(0), Some(1), Some(2), Some(2)];
+        assert_eq!(agent_list_gaps(0, &groups), vec![0, 1, 1, 0, 0]);
+        assert_eq!(agent_list_gaps(2, &groups), vec![2, 2, 2, 2, 0]);
+    }
+
+    #[test]
+    fn ungrouped_lists_keep_the_configured_gap() {
+        let groups = [None, None, None];
+        assert_eq!(agent_list_gaps(0, &groups), vec![0, 0, 0]);
+        assert_eq!(agent_list_gaps(1, &groups), vec![1, 1, 0]);
+    }
+}
