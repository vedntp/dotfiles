+
+#[test]
+fn active_tab_completion_stays_unseen_while_client_views_another_endpoint() {
+    use api::schema::{Method, PaneAgentState, PaneReportAgentParams};
+
+    fn complete(server: &mut HeadlessServer, pane_id: crate::layout::PaneId, seq: u64) -> bool {
+        let public_pane_id = server.app.public_pane_id(0, pane_id).unwrap();
+        for (offset, state) in [PaneAgentState::Working, PaneAgentState::Idle]
+            .into_iter()
+            .enumerate()
+        {
+            completion_guard_api_report(
+                server,
+                Method::PaneReportAgent(PaneReportAgentParams {
+                    pane_id: public_pane_id.clone(),
+                    source: "custom:pi".into(),
+                    agent: "pi".into(),
+                    state,
+                    message: None,
+                    seq: Some(seq + offset as u64),
+                    agent_session_id: None,
+                    agent_session_path: None,
+                    resume_argv: None,
+                }),
+            );
+        }
+        server.app.state.workspaces[0].panes[&pane_id].seen
+    }
+
+    let mut server = test_headless_server();
+    server.app.state.workspaces = vec![crate::workspace::Workspace::test_new("active")];
+    server.app.state.ensure_test_terminals();
+    server.app.state.active = Some(0);
+    server.app.state.toast_config.delay_seconds = 0;
+    let pane_id = server.app.state.workspaces[0].tabs[0].root_pane;
+    server.handle_internal_event_with_forwarding(AppEvent::AgentProcessDetected {
+        pane_id,
+        agent: crate::detect::Agent::Pi,
+        observed_at: Instant::now(),
+    });
+
+    // No client shell at all keeps the historical unknown-focus behaviour.
+    server.sync_foreground_client_state();
+    assert_eq!(server.app.state.outer_terminal_focus, None);
+    assert!(complete(&mut server, pane_id, 1));
+
+    // A client shell that released its surface is viewing another endpoint.
+    let (writer, _control_rx, _render_rx) = test_client_writer();
+    let mut connection = ClientConnection::new_with_mode(
+        ClientConnectionMode::ClientShell,
+        (80, 24),
+        Default::default(),
+        1,
+        RenderEncoding::SemanticFrame,
+        Some(writer),
+    );
+    connection.shell_surface_active = false;
+    connection.outer_terminal_focus = Some(false);
+    server.clients.insert(1, connection);
+    server.sync_foreground_client_state();
+    assert_eq!(server.foreground_client_id, None);
+    assert_eq!(server.app.state.outer_terminal_focus, Some(false));
+    assert!(!server.active_tab_suppresses_notifications(true));
+    assert!(
+        !complete(&mut server, pane_id, 10),
+        "completion must be done"
+    );
+
+    // Switching back and focusing the endpoint marks its active tab seen.
+    server.clients.get_mut(&1).unwrap().shell_surface_active = true;
+    server.clients.get_mut(&1).unwrap().outer_terminal_focus = Some(true);
+    assert!(server.promote_client_to_foreground(1));
+    assert!(server.app.state.workspaces[0].panes[&pane_id].seen);
+}
