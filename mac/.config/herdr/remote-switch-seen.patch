diff --git a/src/server/headless/tests/mod.rs b/src/server/headless/tests/mod.rs
index 3ab7ec0..9614a8a 100644
--- a/src/server/headless/tests/mod.rs
+++ b/src/server/headless/tests/mod.rs
@@ -8333,3 +8333,77 @@ fn no_handle_internal_event_bypass_in_module() {
