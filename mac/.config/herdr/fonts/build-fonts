#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["fonttools", "skia-pathops"]
# ///
"""Rebuild the JetBrains Mono Herdr fonts that carry the sidebar logo glyphs.

Each output is a stock JetBrainsMono Nerd Font Mono face with the glyphs from
a donor font in this directory grafted on at U+E1A0 and up, renamed so it
installs as its own family. See docs/herdr-sidebar.md.

    build-fonts                 # write to ./build
    build-fonts --install       # write to ~/Library/Fonts
    build-fonts --check         # compare a fresh build with ~/Library/Fonts
"""
import argparse
import sys
import tempfile
from pathlib import Path

import pathops
from fontTools.pens.cu2quPen import Cu2QuPen
from fontTools.pens.recordingPen import RecordingPen
from fontTools.pens.transformPen import TransformPen
from fontTools.pens.ttGlyphPen import TTGlyphPen
from fontTools.ttLib import TTFont

HERE = Path(__file__).resolve().parent
FONTS = Path.home() / "Library/Fonts"
STYLES = ("Regular", "Italic", "Light", "LightItalic")
# output file stem -> (family name, donor font)
FAMILIES = {
    "JetBrainsMonoHerdr": ("JetBrains Mono Herdr", "logos.ttf"),
    "JetBrainsMonoHerdrXL": ("JetBrains Mono Herdr XL", "logos-xl.ttf"),
}
FIRST, LAST = 0xE1A0, 0xE1BF  # logos, host logos, working square, prompt logos
# Host logos, copied from the base Nerd Font glyphs and scaled to fill the
# Claude logo's box (U+E1A0), so they look the same size in the sidebar.
HOST_LOGOS = {
    0xE1B0: 0xF179,  # apple
    0xE1B1: 0xF303,  # arch
    0xE1B2: 0xF31B,  # ubuntu
    0xE1B3: 0xF17C,  # linux
    0xE1B4: 0xF17A,  # windows
}
# Starship prompt logos, each drawn across two cells: the left half at the
# codepoint and the right half at the next one. Each half stays inside its own
# cell, so every terminal draws it the same way, and the logo's centre lands
# on the line between the two cells. Values: source glyph, height in units.
PROMPT_LOGOS = {
    0xE1B9: (0xF303, 800),  # arch, U+E1B9 U+E1BA
    0xE1BB: (0xF179, 715),  # apple, U+E1BB U+E1BC
}
# A filled square for the working state, smaller than the 🟨 emoji. Herdr
# colours it through a `rules` entry in config.toml.
WORKING_SQUARE = 0xE1B8


def logo_glyphs(font):
    cmap = font.getBestCmap()
    return {code: cmap[code] for code in sorted(cmap) if FIRST <= code <= LAST}


def add_host_logos(font, donor, order):
    glyf = font["glyf"]
    ref = donor["glyf"][donor.getBestCmap()[FIRST]]
    size = max(ref.xMax - ref.xMin, ref.yMax - ref.yMin)
    centre = ((ref.xMin + ref.xMax) / 2, (ref.yMin + ref.yMax) / 2)
    cmap = font.getBestCmap()
    glyphs = font.getGlyphSet()
    for code, source in HOST_LOGOS.items():
        src = glyf[cmap[source]]
        src.recalcBounds(glyf)
        scale = size / max(src.xMax - src.xMin, src.yMax - src.yMin)
        dx = centre[0] - scale * (src.xMin + src.xMax) / 2
        dy = centre[1] - scale * (src.yMin + src.yMax) / 2
        pen = TTGlyphPen(glyphs)
        glyphs[cmap[source]].draw(TransformPen(pen, (scale, 0, 0, scale, dx, dy)))
        name = f"herdrhost{code:04X}"
        order.append(name)
        glyf[name] = pen.glyph()
        font["hmtx"][name] = font["hmtx"][cmap[source]]
        for table in font["cmap"].tables:
            if table.isUnicode():
                table.cmap[code] = name


def add_prompt_logos(font, order):
    glyf = font["glyf"]
    cmap = font.getBestCmap()
    glyphs = font.getGlyphSet()
    advance = font["hmtx"]["space"][0]
    for code, (source, height) in PROMPT_LOGOS.items():
        src = glyf[cmap[source]]
        src.recalcBounds(glyf)
        scale = height / (src.yMax - src.yMin)
        dx = advance - scale * (src.xMin + src.xMax) / 2
        dy = (1 - scale) * (src.yMin + src.yMax) / 2
        logo = pathops.Path()
        glyphs[cmap[source]].draw(TransformPen(logo.getPen(), (scale, 0, 0, scale, dx, dy)))
        for half in (0, 1):
            left = half * advance
            cell = pathops.Path()
            pen = cell.getPen()
            pen.moveTo((left, -2000))
            pen.lineTo((left, 2000))
            pen.lineTo((left + advance, 2000))
            pen.lineTo((left + advance, -2000))
            pen.closePath()
            part = pathops.op(logo, cell, pathops.PathOp.INTERSECTION)
            pen = TTGlyphPen(None)
            part.draw(TransformPen(Cu2QuPen(pen, 1), (1, 0, 0, 1, -left, 0)))
            name = f"herdrprompt{code + half:04X}"
            order.append(name)
            glyph = glyf[name] = pen.glyph()
            glyph.recalcBounds(glyf)
            # macOS places a glyph by its left side bearing, not its outline.
            font["hmtx"][name] = (advance, glyph.xMin)
            for table in font["cmap"].tables:
                if table.isUnicode():
                    table.cmap[code + half] = name


def add_working_square(font, donor, order):
    ref = donor["glyf"][donor.getBestCmap()[FIRST]]
    # Emoji fill two cells; the blank (U+2800) after the square in the token
    # keeps it two cells wide.
    advance = font["hmtx"]["space"][0]
    half = round(0.3 * 2 * advance)
    # Measured on screen: this lines the square up with the emoji in the
    # rows below it.
    cx, cy = round(0.86 * advance), round((ref.yMin + ref.yMax) / 2) + 30
    pen = TTGlyphPen(None)
    pen.moveTo((cx - half, cy - half))
    pen.lineTo((cx - half, cy + half))
    pen.lineTo((cx + half, cy + half))
    pen.lineTo((cx + half, cy - half))
    pen.closePath()
    name = f"herdrworking{WORKING_SQUARE:04X}"
    order.append(name)
    font["glyf"][name] = pen.glyph()
    # macOS places a glyph by its left side bearing, not its outline, so it
    # must match the outline's left edge or the square never moves.
    font["hmtx"][name] = (advance, cx - half)
    for table in font["cmap"].tables:
        if table.isUnicode():
            table.cmap[WORKING_SQUARE] = name


def build(stem, style, base_dir):
    family, donor_name = FAMILIES[stem]
    base_path = base_dir / f"JetBrainsMonoNerdFontMono-{style}.ttf"
    if not base_path.is_file():
        sys.exit(f"missing base font {base_path} (brew install --cask font-jetbrains-mono-nerd-font)")
    font = TTFont(base_path)
    donor = TTFont(HERE / donor_name)
    if font["head"].unitsPerEm != donor["head"].unitsPerEm:
        sys.exit(f"{donor_name} and {base_path.name} use different units per em")

    order = font.getGlyphOrder()
    for code, name in logo_glyphs(donor).items():
        glyph = donor["glyf"][name]
        if glyph.isComposite():
            sys.exit(f"{donor_name}: {name} is a composite glyph")
        order.append(name)
        font["glyf"][name] = glyph
        font["hmtx"][name] = donor["hmtx"][name]
        for table in font["cmap"].tables:
            if table.isUnicode():
                table.cmap[code] = name
    add_host_logos(font, donor, order)
    add_prompt_logos(font, order)
    add_working_square(font, donor, order)
    # Claude Code marks its messages with U+23FA, which the base font lacks.
    # Without this, Linux falls back to a colour emoji font and draws an
    # orange square; map it to the font's own black circle instead.
    cmap = font.getBestCmap()
    if 0x23FA not in cmap:
        for table in font["cmap"].tables:
            if table.isUnicode():
                table.cmap[0x23FA] = cmap[0x25CF]
    font.setGlyphOrder(order)

    names = {
        1: family,
        3: f"HerdrLocal-{style}-1",
        4: f"{family} {style}",
        6: f"{stem}-{style}",
        16: family,
    }
    for record in font["name"].names:
        if record.nameID in names:
            record.string = names[record.nameID]
    return font


def fingerprint(font):
    """Everything a terminal reads: names, the full cmap, logo outlines, widths."""
    glyphs = font.getGlyphSet()
    outlines = {}
    for code, name in logo_glyphs(font).items():
        pen = RecordingPen()
        glyphs[name].draw(pen)
        outlines[code] = (name, font["hmtx"][name], pen.value)
    names = sorted((r.nameID, r.platformID, r.langID, r.toUnicode()) for r in font["name"].names)
    return names, font.getBestCmap(), outlines, font["hmtx"].metrics, font.getGlyphOrder()


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--install", action="store_true", help="write into ~/Library/Fonts")
    parser.add_argument("--check", action="store_true", help="compare a fresh build with the installed fonts")
    parser.add_argument("--base-dir", type=Path, default=FONTS, help="where the JetBrainsMono Nerd Font Mono files live")
    args = parser.parse_args()

    out = FONTS if args.install else Path(tempfile.mkdtemp()) if args.check else HERE / "build"
    out.mkdir(parents=True, exist_ok=True)
    stale = []
    for stem in FAMILIES:
        for style in STYLES:
            target = out / f"{stem}-{style}.ttf"
            build(stem, style, args.base_dir).save(target)
            if args.check:
                # Compare saved files: saving rewrites outlines, so an
                # unsaved build never matches an installed font.
                installed = FONTS / target.name
                if not installed.is_file() or fingerprint(TTFont(installed)) != fingerprint(TTFont(target)):
                    stale.append(target.name)
                continue
            print(target)
    if args.check:
        print("stale or missing: " + ", ".join(stale) if stale else "installed fonts match a fresh build")
        return 1 if stale else 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
