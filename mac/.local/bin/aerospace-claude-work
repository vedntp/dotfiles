#!/bin/bash
# Open Claude Code (bypass permissions) as a new Alacritty window
# on the first empty workspace of the focused monitor (stay put if none).
# Bound to alt-a in aerospace.toml.

empty_ws=$(/opt/homebrew/bin/aerospace list-workspaces --monitor focused --empty | head -1)
[ -n "$empty_ws" ] && /opt/homebrew/bin/aerospace workspace "$empty_ws"

exec /bin/bash "$HOME/.local/bin/alacritty-new-window" \
  -e "$HOME/.local/bin/claude" --dangerously-skip-permissions
