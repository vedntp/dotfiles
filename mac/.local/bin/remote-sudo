#!/usr/bin/env bash
set -euo pipefail

# Run a command as root on an SSH host, asking for its sudo password in a
# native macOS dialog (the Mac-side stand-in for pkexec over SSH).
# The password goes to `sudo -S` on the host's stdin, never into argv or a file.
#
#   remote-sudo omarchy 'pacman -Syu --needed rex'

if [[ $# -lt 2 ]]; then
  echo "usage: remote-sudo HOST COMMAND" >&2
  exit 2
fi

host="$1"
command="$2"

password="$(osascript \
  -e 'on run argv' \
  -e 'text returned of (display dialog ("sudo password on " & item 1 of argv & ":") default answer "" with hidden answer with title "remote-sudo" with icon caution)' \
  -e 'end run' "$host")" || exit 1

printf '%s\n' "$password" | ssh "$host" "sudo -S -p '' -- sh -c $(printf '%q' "$command")"
