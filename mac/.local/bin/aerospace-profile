#!/bin/bash
# aerospace-profile: switch AeroSpace between monitor profiles.
#
#   aerospace-profile solo   laptop is home, workspace 10 on the external screen
#   aerospace-profile duo    LG main screen, laptop for support workspaces
#   aerospace-profile        rebuild with the current profile (after editing base.toml)
#   aerospace-profile -c     print the current profile
#
# Builds ~/.config/aerospace/aerospace.toml from base.toml plus
# profiles/<name>.toml, checks that AeroSpace accepts it, then reloads.
# The first line of the generated file records the profile, so the choice
# survives reboots and AeroSpace upgrades. Called by aerospace-display-watcher
# when an external screen is connected.

set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

dir="$HOME/.config/aerospace"
base="$dir/base.toml"
out="$dir/aerospace.toml"

current() { sed -n '1s/^# profile: //p' "$out" 2>/dev/null || true; }

case "${1:-}" in
  -c|--current) p="$(current)"; echo "${p:-none}"; exit 0 ;;
  -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

name="${1:-$(current)}"
name="${name:-duo}"
profile="$dir/profiles/$name.toml"

if [ ! -f "$profile" ]; then
  echo "aerospace-profile: unknown profile '$name'. Available:" >&2
  ls "$dir/profiles" | sed -n 's/\.toml$//p' | sed 's/^/  /' >&2
  exit 1
fi

tmp="$out.tmp.$$"
backup="$out.prev.$$"
trap 'rm -f "$tmp" "$backup"' EXIT

{
  echo "# profile: $name"
  echo "# GENERATED by aerospace-profile from base.toml + profiles/$name.toml."
  echo "# Do not edit. Edit base.toml or the profile, then run aerospace-profile."
  echo
  cat "$base"
  echo
  cat "$profile"
} > "$tmp"

[ -f "$out" ] && cp "$out" "$backup"
mv "$tmp" "$out"

# AeroSpace not running: the file is in place and will load on next start.
if ! pgrep -xq AeroSpace; then
  echo "profile: $name (AeroSpace not running, applies on next start)"
  exit 0
fi

if ! err="$(aerospace reload-config --dry-run --no-gui 2>&1)"; then
  if [ -f "$backup" ]; then mv "$backup" "$out"; else rm -f "$out"; fi
  echo "aerospace-profile: AeroSpace rejected the '$name' config, kept the old one:" >&2
  echo "$err" >&2
  exit 1
fi

aerospace reload-config
echo "profile: $name"
