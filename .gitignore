# macOS
.DS_Store

# Secrets and machine-specific overrides (not version controlled)
**/.zshenv.local
**/.zshrc.local
**/config.local

# Device-specific identifiers
mac/.config/linearmouse/linearmouse.json

# GCP credentials
**/gcloud/
*-service-account.json

# Python artifacts
__pycache__/
__init__.py

# Backups
backups/
*.bak.*
tmux.bak.*

# Cache
*.cache/
mac/.config/tmux/plugins/
mac/.config/herdr/plugins/herdr-focus-notify/
mac/.config/alacritty/alacritty.toml.before-*
mac/.config/herdr/initial-host-theme-replay.patch
